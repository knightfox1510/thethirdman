 "long": [
  {
   "vo": "One hundred and sixty kilometres an hour. Shoaib Akhtar has done it. Brett Lee has done it. No Indian bowler ever has.",
   "scene": {
    "type": "statement",
    "kicker": "THE 160 KM/H CLUB",
    "lines": [
     {
      "t": "NO INDIAN"
     },
     {
