{
  "manifest_version": 3,
  "name": "Third Man Match Capture",
  "version": "1.6.2",
  "description": "Saves the match data of Cricinfo or Cricbuzz match pages you have open, one at a time or from a list you give it (batch mode, human pace), as JSON files for The Third Man analysis. Optional auto-resume and keep-awake for unattended runs.",
  "icons": {
    "16": "icons/i16.png",
    "48": "icons/i48.png",
    "128": "icons/i128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.espncricinfo.com/*",
        "https://www.cricinfo.com/*",
        "https://www.cricbuzz.com/*",
        "https://m.cricbuzz.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.espncricinfo.com/*",
        "https://www.cricinfo.com/*",
        "https://www.cricbuzz.com/*",
        "https://m.cricbuzz.com/*"
      ],
      "js": [
        "panel.js",
        "batch.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "power",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  }
}